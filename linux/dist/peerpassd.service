[Unit]
Description=peerpass vault and LAN sync daemon
After=network-online.target

[Service]
ExecStart=%h/.local/bin/peerpassd
Restart=on-failure
# Hardening: the daemon only needs its data dir, the runtime socket and the LAN.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=%h/.local/share/peerpass %t
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
# Keep secrets out of swap and core dumps.
LimitCORE=0

[Install]
WantedBy=default.target
